server {
  listen       80;
  server_name  _;
  root         /usr/share/nginx/html;
  index        index.html;

  # Reasonable gzip — the GeoLite2 mmdb is already compact binary so don't bother,
  # but the JS bundle and CSS benefit a lot.
  gzip              on;
  gzip_min_length   1024;
  gzip_proxied      any;
  gzip_types        application/javascript application/json text/css image/svg+xml;

  # SPA fallback — every non-asset path falls through to index.html so a
  # hard refresh on a deep-linked URL still works.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Replace the Vite dev proxy. The browser fetches /rest/... relative to
  # this origin, nginx forwards to the router with an injected basic-auth
  # header. Whatever Authorization the browser sent is overridden here,
  # so the JS bundle's auth is irrelevant in this deployment.
  location /rest/ {
    proxy_pass              ${ROUTER_URL}/rest/;
    proxy_set_header        Authorization    "Basic ${ROUTER_AUTH_B64}";
    proxy_set_header        Accept-Encoding  "";
    proxy_http_version      1.1;
    proxy_ssl_verify        off;
    proxy_connect_timeout   5s;
    proxy_read_timeout      30s;
    proxy_send_timeout      30s;
  }
}
