# Sourced (not executed) by /docker-entrypoint.sh thanks to the .envsh
# extension, so exports persist into the parent shell and are visible to
# the next entrypoint script (20-envsubst-on-templates.sh).
# Shebang intentionally omitted — sourced files don't use it, and `set -eu`
# is avoided so it doesn't leak into the parent shell's later commands.

: "${ROUTER_URL:?ROUTER_URL is required (e.g. http://192.168.200.1)}"
: "${ROUTER_USER:?ROUTER_USER is required}"
: "${ROUTER_PASS:?ROUTER_PASS is required}"

# Strip any trailing slash — proxy_pass appends /rest/ already.
ROUTER_URL="${ROUTER_URL%/}"
export ROUTER_URL

ROUTER_AUTH_B64=$(printf '%s:%s' "$ROUTER_USER" "$ROUTER_PASS" | base64 | tr -d '\n')
export ROUTER_AUTH_B64
