# Prefer passing credentials inline at the CLI:
#   USER=admin PASS=hunter2 URL=http://192.168.200.1 yarn start
#
# These VITE_* vars are an alternate way (e.g. for .env.local):
VITE_MIKROTIK_URL=http://192.168.200.1
VITE_MIKROTIK_USER=admin
VITE_MIKROTIK_PASSWORD=
VITE_POLL_INTERVAL_MS=3000
VITE_GEOIP_DB_URL=/geoip/GeoLite2-City.mmdb
# Comma-separated IPv6 CIDRs that belong to your LAN — typically your ISP's
# delegated prefix. Flows where one endpoint is inside one of these prefixes
# get classified as incoming/outgoing instead of transit (home v6 has no NAT,
# so LAN devices have GUA addresses that otherwise look "public").
#   VITE_LAN_V6_PREFIXES=2001:db8:abcd::/56
# Inline form when starting Vite:
#   LAN_V6_PREFIXES=2001:db8:abcd::/56 yarn start
